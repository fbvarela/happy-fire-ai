# Server-only provider selection. Leave unset or use "mock" for deterministic local development.
WEATHER_PROVIDER=mock

# Optional official DGT DATEX2 road-closure feed. This never creates a route.
DGT_ROAD_CLOSURES_ENABLED=false

# --- Multi-hazard providers (all optional; unset = deterministic mock) ---
# Global, no API key. Open-Meteo Air Quality (Copernicus CAMS).
AIR_QUALITY_PROVIDER=open-meteo
# Global, no API key. Open-Meteo Flood (Copernicus GloFAS river discharge).
FLOOD_PROVIDER=open-meteo
# Ambient gamma dose rate. "bfs" = Germany BfS ODL-Info (µSv/h);
# "safecast" = global citizen-science network (CPM, sparse/stale).
# RADIOACTIVITY_PROVIDER=bfs
# Water quality. "eea-bathing" = EEA bathing-water classification (Europe);
# "eea-pfas" = EEA PFAS monitoring concentrations (sparse).
# WATER_POLLUTION_PROVIDER=eea-bathing
# Radon risk. "epa-ie" = Ireland EPA radon risk map (CC-BY, static).
# RADON_PROVIDER=epa-ie

# Optional hazard weights (JSON, keyed by hazard id). Unnamed hazards share the leftover.
# RISK_WEIGHTS={"wildfire":0.3,"air-quality":0.2}
